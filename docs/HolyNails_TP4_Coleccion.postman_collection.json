        {
          "name": "Login ADMIN — Obtener token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set(\"admin_token\", jsonData.access);",
                  "    console.log(\"admin_token guardado\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_tp4\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": "{{base_url}}/api/auth/login/"
          },
          "response": []
        },
        {
          "name": "Login CLIENTE — Obtener token",
          "event": [
            {
              "listen": "test",
